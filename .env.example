# Database (Supabase / Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/fitwise
DATABASE_SSL=false            # true for Supabase / hosted Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — Google sign-in (see README "Sign in with Google")
APP_URL=http://localhost:3000   # production: https://jobfitwise.se; must match the redirect URI registered with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=                   # comma-separated; these accounts get the admin role at sign-in

# AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5               # resumes, cover letters
CLAUDE_FAST_MODEL=claude-haiku-5-5  # job skill extraction + fit explanations

# Semantic search
PINECONE_API_KEY=
PINECONE_INDEX=fitwise-jobs

# Job listings
SERPAPI_KEY=
RAPIDAPI_KEY=

# Scheduled jobs: Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
# Needed for the weekly job alert emails (vercel.json) and scheduled ingestion.
CRON_SECRET=

# Email (password reset, email confirmation, weekly job alerts) via resend.com.
# Leave empty and those features stay off; everything else works as before.
RESEND_API_KEY=
EMAIL_FROM=                    # e.g. JobFitwise <hej@jobfitwise.se>, on a domain verified in Resend

# Shown on the Privacy, Terms and FAQ pages
CONTACT_EMAIL=
OPERATOR_NAME=

# Free-plan daily limits on paid AI actions (per user, rolling 24 h)
LIMIT_COVER_LETTERS_PER_DAY=10
LIMIT_RESUME_UPLOADS_PER_DAY=5
LIMIT_FIT_EXPLANATIONS_PER_DAY=30

# Plans & payments (see README "Plans & payments (Stripe)")
PAYWALL_ENABLED=false          # false = everyone gets Premium (beta). Set true once Stripe is live.
STRIPE_SECRET_KEY=             # sk_live_… (or sk_test_… while testing)
STRIPE_WEBHOOK_SECRET=         # whsec_… from the webhook endpoint in Stripe
STRIPE_PRICE_PRO=              # price_… for Pro, monthly, SEK
STRIPE_PRICE_PREMIUM=          # price_… for Premium, monthly, SEK
STRIPE_AUTOMATIC_TAX=false     # true only after Stripe Tax is set up
NEXT_PUBLIC_PRICE_PRO_SEK=79   # shown on the pricing page; keep in step with Stripe
NEXT_PUBLIC_PRICE_PREMIUM_SEK=149
