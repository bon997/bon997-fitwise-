# Database (Supabase / Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/fitwise
DATABASE_SSL=false            # true for Supabase / hosted Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — Google sign-in (see README "Sign in with Google")
APP_URL=http://localhost:3000   # must match the redirect URI registered with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=                   # comma-separated; these accounts get the admin role at sign-in

# AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5               # resumes, cover letters
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001  # bulk job skill extraction

# Semantic search
PINECONE_API_KEY=
PINECONE_INDEX=fitwise-jobs

# Job listings
SERPAPI_KEY=
RAPIDAPI_KEY=

# Scheduled jobs: Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
# Needed for the weekly job alert emails (vercel.json) and scheduled ingestion.
CRON_SECRET=

# Email (password reset, email confirmation, weekly job alerts) via resend.com.
# Leave empty and those features stay off; everything else works as before.
RESEND_API_KEY=
EMAIL_FROM=                    # e.g. Fitwise <hej@yourdomain.se>, on a domain verified in Resend

# Shown on the Privacy, Terms and FAQ pages
CONTACT_EMAIL=
OPERATOR_NAME=

# Free-plan daily limits on paid AI actions (per user, rolling 24 h)
LIMIT_COVER_LETTERS_PER_DAY=10
LIMIT_RESUME_UPLOADS_PER_DAY=5
LIMIT_FIT_EXPLANATIONS_PER_DAY=30
